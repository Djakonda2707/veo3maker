# Telegram bot token from @BotFather
BOT_TOKEN=

# Whisper model: tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# cpu or cuda
WHISPER_DEVICE=cpu
# int8 / int8_float16 / float16 / float32
WHISPER_COMPUTE_TYPE=int8
# Leave empty for auto-detect, or set "ru", "en", ...
WHISPER_LANGUAGE=

# Subtitle appearance
SUB_FONT=Arial
# Font size as a fraction of video height (0.075 = ~7.5%)
SUB_FONT_SIZE_RATIO=0.075
# Max words shown at the same time
SUB_MAX_WORDS=3
# bottom / middle / top
SUB_POSITION=bottom
# Highlight color for the active word, ASS format &HBBGGRR& (yellow by default)
SUB_HIGHLIGHT_COLOR=&H0000FFFF&

# Telegram Bot API limit is 20 MB unless you run a local Bot API server
MAX_VIDEO_SIZE_MB=20
