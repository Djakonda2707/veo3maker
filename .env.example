# Telegram bot token from @BotFather
BOT_TOKEN=

# Whisper model: tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# cpu or cuda
WHISPER_DEVICE=cpu
# int8 / int8_float16 / float16 / float32
WHISPER_COMPUTE_TYPE=int8
# Leave empty for auto-detect, or set "ru", "en", ...
WHISPER_LANGUAGE=

# Telegram Bot API limit is 20 MB unless you run a local Bot API server
MAX_VIDEO_SIZE_MB=20


# ===========================================================================
# Viral video production pipeline (pipeline/, см. PIPELINE.md)
# ===========================================================================

# Master switch. 1 = mock everything, zero spend (default). 0 = real APIs.
PIPELINE_DRY_RUN=1

# --- First frame (Nano Banana / Gemini image) ------------------------------
# mock | relay  (relay = OpenAI/Gemini-compatible endpoint, e.g. laozhang.ai)
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
# laozhang.ai (дёшево, доступно из РФ) или Google OpenAI-compat:
#   https://generativelanguage.googleapis.com/v1beta/openai
IMAGE_API_BASE_URL=https://api.laozhang.ai/v1
IMAGE_MODEL=gemini-2.5-flash-image

# --- Animate (image -> video) ----------------------------------------------
# mock | fal
VIDEO_PROVIDER=mock
FAL_API_KEY=
# Wan 2.5 = дёшево. Альтернативы: fal-ai/kling-video/... , fal-ai/bytedance/seedance/...
FAL_VIDEO_MODEL=fal-ai/wan-25/image-to-video

# --- Output format ---------------------------------------------------------
PIPELINE_VIDEO_WIDTH=1080
PIPELINE_VIDEO_HEIGHT=1920
PIPELINE_FPS=30
PIPELINE_SEGMENT_SECONDS=10
PIPELINE_SUBTITLE_PRESET=hormozi

# --- Research (этап 1, позже) ----------------------------------------------
# mock | rapidapi | scrapecreators
SCRAPER_PROVIDER=mock
RAPIDAPI_KEY=
RAPIDAPI_HOST=social-api4.p.rapidapi.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
